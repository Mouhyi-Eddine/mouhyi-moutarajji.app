rules_version = '2';

// Lecture publique des collections du portfolio, écriture réservée au seul
// compte admin. Tout chemin non listé ici est refusé par défaut.
// Remplacez REPLACE_WITH_ADMIN_UID par l'UID du compte admin
// (console Firebase > Authentication > Users > colonne "User UID").
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.uid == 'n4H88iJ39DTv9ViI1rrfDbKvvfv1';
    }

    match /experiences/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /skills/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /education/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /agencies/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Section « Profil » du site public (document unique profile/main).
    match /profile/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
